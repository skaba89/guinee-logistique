generator client {
  provider = "prisma-client-js"
  output   = "../../generated/saas"
}

datasource db {
  provider = "postgresql"
  url      = env("SAAS_DATABASE_URL")
}

enum TenantRole {
  admin
  manager
  agent
  viewer
  client
  ramasseur
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  agencies    Agency[]
  memberships Membership[]
  customers Customer[]
  shipments Shipment[]
}

model Agency {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, code])
}

model Account {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String
  createdAt   DateTime     @default(now())
  passwordHash String?
  memberships Membership[]
}

model Membership {
  organizationId String
  accountId      String
  role           TenantRole
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sessions Session[]
  customerAccess CustomerAccess[]
  missions Mission[]
  @@id([organizationId, accountId])
  @@index([accountId])
}

model Session {
  tokenHash      String   @id
  organizationId String
  accountId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  membership     Membership @relation(fields: [organizationId, accountId], references: [organizationId, accountId], onDelete: Cascade)
  @@index([expiresAt])
}

model LoginAttempt {
  key          String   @id
  count        Int
  windowStart  DateTime
}

enum ShipmentStatus {
  draft
  confirmed
  in_transit
  delivered
  cancelled
}

model Customer {
  id String @id @default(cuid())
  organizationId String
  name String
  email String?
  phone String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipments Shipment[]
  portalAccess CustomerAccess[]
  billingDocuments BillingDocument[]
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

model Shipment {
  id String @id @default(cuid())
  organizationId String
  customerId String
  trackingNumber String @unique
  origin String
  destination String
  status ShipmentStatus @default(draft)
  version Int @default(0)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  events ShipmentEvent[]
  parcels Parcel[]
  missions Mission[]
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, customerId])
}

model ShipmentEvent {
  id String @id @default(cuid())
  organizationId String
  shipmentId String
  actorId String
  status ShipmentStatus
  version Int
  createdAt DateTime @default(now())
  shipment Shipment @relation(fields: [organizationId, shipmentId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, shipmentId, version])
}

model CustomerAccess {
  organizationId String
  accountId String
  customerId String
  membership Membership @relation(fields: [organizationId, accountId], references: [organizationId, accountId], onDelete: Cascade)
  customer Customer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)
  @@id([organizationId, accountId, customerId])
  @@index([organizationId, customerId])
}

model Parcel {
  id String @id @default(cuid())
  organizationId String
  shipmentId String
  barcode String @unique
  description String
  weightGrams Int
  createdAt DateTime @default(now())
  shipment Shipment @relation(fields: [organizationId, shipmentId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, shipmentId])
}

enum MissionKind {
  pickup
  delivery
}

enum MissionStatus {
  assigned
  completed
  cancelled
}

model Mission {
  id String @id @default(cuid())
  organizationId String
  shipmentId String
  assigneeId String
  kind MissionKind
  status MissionStatus @default(assigned)
  address String
  recipient String?
  note String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  shipment Shipment @relation(fields: [organizationId, shipmentId], references: [organizationId, id], onDelete: Restrict)
  assignee Membership @relation(fields: [organizationId, assigneeId], references: [organizationId, accountId], onDelete: Restrict)
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, shipmentId])
}

enum BillingStatus {
  quote
  invoice
}

enum PaymentMethod {
  cash
  bank
  orange_money
  mtn_momo
}

model BillingDocument {
  id String @id @default(cuid())
  organizationId String
  customerId String
  customerName String
  quoteNumber String @unique
  invoiceNumber String? @unique
  status BillingStatus @default(quote)
  description String
  quantity Int
  unitPrice Int
  total Int
  paid Int @default(0)
  version Int @default(0)
  createdAt DateTime @default(now())
  issuedAt DateTime?
  customer Customer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  payments BillingPayment[]
  lines BillingLine[]
  subtotal Int
  taxTotal Int @default(0)
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

model BillingLine {
  id String @id @default(cuid())
  organizationId String
  documentId String
  position Int
  description String
  quantity Int
  unitPrice Int
  taxBps Int
  subtotal Int
  tax Int
  total Int
  document BillingDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, documentId, position])
}

model BillingPayment {
  id String @id @default(cuid())
  organizationId String
  documentId String
  reference String
  amount Int
  method PaymentMethod
  actorId String
  createdAt DateTime @default(now())
  document BillingDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, reference])
  @@index([organizationId, documentId])
}
