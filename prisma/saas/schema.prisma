generator client {
  provider = "prisma-client-js"
  output   = "../../generated/saas"
}

datasource db {
  provider = "postgresql"
  url      = env("SAAS_DATABASE_URL")
}

enum TenantRole {
  admin
  manager
  agent
  viewer
  client
  ramasseur
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  agencies    Agency[]
  memberships Membership[]
}

model Agency {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, code])
}

model Account {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String
  createdAt   DateTime     @default(now())
  passwordHash String?
  memberships Membership[]
}

model Membership {
  organizationId String
  accountId      String
  role           TenantRole
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sessions Session[]
  @@id([organizationId, accountId])
  @@index([accountId])
}

model Session {
  tokenHash      String   @id
  organizationId String
  accountId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  membership     Membership @relation(fields: [organizationId, accountId], references: [organizationId, accountId], onDelete: Cascade)
  @@index([expiresAt])
}

model LoginAttempt {
  key          String   @id
  count        Int
  windowStart  DateTime
}
